# =============================================================================
# field-iq-map .gitignore
# Angular/TypeScript frontend · Java REST/GraphQL backend · PostgreSQL · Docker
# Supports running against both the REAL and the MOCK API via Docker.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & secrets
# Real secrets stay local; committed templates document required variables.
# -----------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!.env.*.example
!.env.mock
!*.env.example
# Angular environment files with real credentials (keep the defaults committed)
**/environments/environment.local.ts
**/environments/environment.*.local.ts
# Backend local overrides
**/application-local.yml
**/application-local.yaml
**/application-local.properties
**/application-secret*.yml
**/application-secret*.properties
*.pem
*.key
*.p12
*.jks
!**/src/test/resources/**/*.jks
secrets/

# -----------------------------------------------------------------------------
# Docker
# Compose files for real/mock (docker-compose.yml, docker-compose.mock.yml,
# docker-compose.real.yml, etc.) ARE committed. Only per-developer overrides
# and runtime volume data are ignored.
# -----------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml
.docker/
docker/volumes/
docker/data/
**/.docker-data/

# -----------------------------------------------------------------------------
# PostgreSQL
# Init/migration/seed SQL (e.g. docker/postgres/init/*.sql, db/migration/*.sql)
# IS committed. Only local data directories and ad-hoc dumps are ignored.
# -----------------------------------------------------------------------------
pgdata/
postgres-data/
postgres_data/
**/postgres/data/
*.dump
*.backup
*.pgdump
!**/seed/**/*.dump

# -----------------------------------------------------------------------------
# Mock API
# Mock definitions (mocks/, wiremock/mappings, wiremock/__files, json-server
# db.json, MSW handlers) ARE committed. Only runtime/recorded output is ignored.
# -----------------------------------------------------------------------------
**/wiremock/recordings/
**/mock-server/logs/
mockServiceWorker.js.map

# -----------------------------------------------------------------------------
# Node / Angular / TypeScript
# -----------------------------------------------------------------------------
node_modules/
.angular/
.nx/
dist/
out-tsc/
tmp/
.tmp/
*.tsbuildinfo
.sass-cache/
.eslintcache
.stylelintcache
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/libpeerconnection.log
testem.log
/typings
connect.lock

# -----------------------------------------------------------------------------
# GraphQL / OpenAPI generated types
# Generated client types (apps/web/src/app/api/generated, services/mock-api/src/generated)
# ARE committed on purpose: CI regenerates them and fails on `git diff`.
# Only scratch introspection output is ignored.
# -----------------------------------------------------------------------------
**/graphql.schema.json

# -----------------------------------------------------------------------------
# Unit tests & coverage
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
junit.xml
**/test-output/

# -----------------------------------------------------------------------------
# E2E tests (Playwright / Cypress)
# Specs and fixtures ARE committed; run artifacts are ignored.
# -----------------------------------------------------------------------------
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/
**/e2e/.auth/
**/e2e/reports/
**/e2e/results/
**/e2e/screenshots/
**/e2e/videos/
cypress/videos/
cypress/screenshots/
cypress/downloads/
cypress.env.json

# -----------------------------------------------------------------------------
# Java (Maven / Gradle / Spring Boot)
# -----------------------------------------------------------------------------
target/
.mvn/wrapper/maven-wrapper.properties.bak
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
!.mvn/wrapper/maven-wrapper.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.apt_generated/
.apt_generated_tests/
.factorypath
.classpath
.project
.settings/
.springBeans
.sts4-cache/
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/
!frontend/**/bin/
HELP.md

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
logs/
*.log
*.log.*

# -----------------------------------------------------------------------------
# IDEs & editors
# -----------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.swp
*.swo
*~
nbproject/
nbbuild/
nbdist/
.nb-gradle/

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
