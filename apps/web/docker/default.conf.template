# FieldIQ web: static Angular app + same-origin proxy to the active backend (no CORS).
# ${API_UPSTREAM} is substituted at container start (mock-api or Spring Boot api).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types application/json application/geo+json application/graphql-response+json
               application/javascript text/javascript text/css text/csv image/svg+xml
               application/x-protobuf;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Runtime configuration generated by 40-fieldiq-env.sh.
    location = /env.js {
        alias /tmp/fieldiq/env.js;
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    location ~ ^/(graphql|graphiql|swagger-ui|swagger-ui\.html|v3/api-docs) {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    # MapLibre's ES-module web worker must be served as JavaScript.
    location ~* \.mjs$ {
        types { }
        default_type application/javascript;
        add_header Cache-Control "public, max-age=86400";
    }

    # Content-hashed bundles can be cached forever.
    location ~* "-[A-Za-z0-9_]{8}\.(js|css)$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
