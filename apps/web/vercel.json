{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "dependabot/**": false
    }
  },
  "installCommand": "npm ci",
  "buildCommand": "npm run build && node scripts/vercel-env.mjs",
  "outputDirectory": "dist/web/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fieldiq-mock-api.vercel.app/api/:path*"
    },
    {
      "source": "/graphql",
      "destination": "https://fieldiq-mock-api.vercel.app/graphql"
    },
    {
      "source": "/graphiql",
      "destination": "https://fieldiq-mock-api.vercel.app/graphql"
    },
    {
      "source": "/((?!.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/env.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
