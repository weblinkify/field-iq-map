{
  "name": "@fieldiq/mock-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Schema-driven mock of the FieldIQ API (same GraphQL + REST contract as services/api)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "codegen": "graphql-codegen --config codegen.ts && openapi-typescript ../../shared/openapi/openapi.yaml -o src/generated/openapi.ts && prettier --write src/generated",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "golden": "tsx scripts/golden.ts"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.1.5",
    "express": "^5.3.0",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
