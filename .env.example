# Copy to .env (git-ignored). Everything is optional: `make up-mock` works with no .env at all.

# Map engine: set a PUBLIC Mapbox token (pk.*) to use Mapbox GL JS. Without it the app uses
# MapLibre GL JS with the keyless OpenFreeMap basemap. Never put a secret (sk.*) token here.
MAPBOX_TOKEN=

# Basemap for MapLibre: openfreemap (online, keyless) | offline (no network; CI uses this)
BASEMAP=openfreemap

# Host ports
WEB_PORT=8080
API_PORT=8081
MOCK_API_PORT=4000
POSTGRES_PORT=5433

# Real mode database password (local development only)
POSTGRES_PASSWORD=fieldiq

# Real mode behaviour
FIELDIQ_SIMULATOR_INTERVAL=30s
FIELDIQ_SEED_FORCE=false

# Angular build configuration baked into the web image: production | e2e (adds test hooks)
NG_CONFIG=production
