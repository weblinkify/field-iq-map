# FieldIQ v2 GraphQL contract — the single source of truth.
# Served by services/api (Spring for GraphQL, schema-first) and services/mock-api (graphql-yoga).
# Frontend types are generated from this file (apps/web: npm run codegen).

"ISO-8601 timestamp in UTC, e.g. 2026-10-10T12:00:00Z"
scalar DateTime

enum SensorType {
  TEMPERATURE
  HUMIDITY
  NOISE
  AIR_QUALITY_PM25
  MULTI
}

enum SensorStatus {
  ONLINE
  OFFLINE
  ALERT
  LOW_BATTERY
}

enum Metric {
  TEMPERATURE
  HUMIDITY
  NOISE
  PM25
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

"WGS84 coordinates (EPSG:4326)."
type Coordinates {
  lat: Float!
  lon: Float!
}

type Sensor {
  "Stable identifier, e.g. FIQ-00042"
  id: ID!
  name: String!
  type: SensorType!
  status: SensorStatus!
  location: Coordinates!
  municipality: String!
  "Region (maakunta)"
  region: String!
  siteName: String!
  site: Site!
  installedAt: DateTime!
  batteryPct: Int!
  firmware: String!
  lastSeenAt: DateTime!
  "Most recent value for every metric this sensor measures."
  latestReadings: [Reading!]!
  "Hourly history. Defaults to the last 24 hours, all metrics."
  readings(from: DateTime, to: DateTime, metric: Metric): [Reading!]!
  alerts(activeOnly: Boolean = false): [Alert!]!
}

type Reading {
  sensorId: ID!
  ts: DateTime!
  metric: Metric!
  value: Float!
  unit: String!
}

type Site {
  id: ID!
  name: String!
  municipality: String!
  region: String!
  location: Coordinates!
  sensorCount: Int!
}

type Alert {
  id: ID!
  sensorId: ID!
  sensorName: String!
  severity: AlertSeverity!
  message: String!
  createdAt: DateTime!
  resolvedAt: DateTime
}

input SensorFilter {
  types: [SensorType!]
  statuses: [SensorStatus!]
  regions: [String!]
  "Case-insensitive match on id, name, municipality or site name."
  search: String
}

"Bounding box in WGS84. lon -180..180, lat -90..90, min < max."
input BBoxInput {
  minLon: Float!
  minLat: Float!
  maxLon: Float!
  maxLat: Float!
}

type SensorConnection {
  edges: [SensorEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type SensorEdge {
  cursor: String!
  node: Sensor!
}

type PageInfo {
  hasNextPage: Boolean!
  endCursor: String
}

type StatusCount {
  status: SensorStatus!
  count: Int!
}

type TypeCount {
  type: SensorType!
  count: Int!
}

type MetricAverage {
  metric: Metric!
  "Average of the latest readings, null when no sensor in scope measures the metric."
  average: Float
  unit: String!
  sampleSize: Int!
}

type SensorStats {
  total: Int!
  byStatus: [StatusCount!]!
  byType: [TypeCount!]!
  averages: [MetricAverage!]!
  activeAlerts: Int!
  regionsCovered: Int!
}

type RegionSummary {
  region: String!
  sensorCount: Int!
  onlineCount: Int!
  alertCount: Int!
}

type Query {
  sensor(id: ID!): Sensor
  "Cursor-paginated, ordered by id. first defaults to 20 (max 200)."
  sensors(filter: SensorFilter, bbox: BBoxInput, first: Int = 20, after: String): SensorConnection!
  "Counts by status/type and averages of the latest readings."
  sensorStats(bbox: BBoxInput, filter: SensorFilter): SensorStats!
  regions: [RegionSummary!]!
  sites(region: String): [Site!]!
  alerts(activeOnly: Boolean = true, first: Int = 100): [Alert!]!
}
